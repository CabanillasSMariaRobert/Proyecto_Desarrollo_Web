    // Mappers
    private UsuarioAdminDTO mapToUsuarioAdminDTO(Usuario u) {
        // TODO: Calcular totalCompras y totalGastado con queries
        return UsuarioAdminDTO.builder()
            .idUsuario(u.getIdUsuario())
            .nombres(u.getNombres())
            .apellidos(u.getApellidos())
            .correo(u.getCorreo())
            .rol(u.getRol())
            .estaVerificado(u.getEstaVerificado())
            .estaActivo(u.getEstaActivo())
            .estaBaneado(u.getEstaBaneado())
            .razonBaneo(u.getRazonDeBaneo())
            .creadoEl(u.getCreadoEl())
            .totalCompras(0)
            .totalGastado(BigDecimal.ZERO)
            .build();
    }

    // ... otros mappers
}