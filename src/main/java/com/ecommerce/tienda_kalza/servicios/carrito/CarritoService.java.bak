            carrito.agregarDetalle(detalle);
        }

        // 4. Recalcular totales carrito
        recalcularCarrito(carrito);
        carrito = compraRepository.save(carrito);

        return mapToDTO(carrito);
    }

    @Transactional
    public CarritoResponseDTO actualizarCantidad(Integer usuarioId, Integer idVariante, Integer nuevaCantidad) {
        Compra carrito = obtenerOCrearCarrito(usuarioId);
        
        DetalleDeCompra detalle = carrito.getDetalles().stream()
            .filter(d -> d.getVarianteDeZapato().getIdVarianteDeZapato().equals(idVariante))
            .findFirst()
            .orElseThrow(() -> new EntityNotFoundException("Item no en carrito"));

        if (nuevaCantidad <= 0) {
            return eliminarItem(usuarioId, idVariante);
        }

        VarianteDeZapato variante = detalle.getVarianteDeZapato();
        if (variante.getStock() < nuevaCantidad) {
            throw new IllegalArgumentException("Stock insuficiente. Disponible: " + variante.getStock());
        }

        detalle.setCantidad(nuevaCantidad);
        recalcularDetalle(detalle);
        recalcularCarrito(carrito);
        compraRepository.save(carrito);

        return mapToDTO(carrito);
    }

    @Transactional
    public CarritoResponseDTO eliminarItem(Integer usuarioId, Integer idVariante) {
        Compra carrito = obtenerOCrearCarrito(usuarioId);
        
        carrito.getDetalles().removeIf(d -> 
            d.getVarianteDeZapato().getIdVarianteDeZapato().equals(idVariante));
        
        recalcularCarrito(carrito);
        compraRepository.save(carrito);

        return mapToDTO(carrito);
    }

    @Transactional
    public void vaciarCarrito(Integer usuarioId) {
        Compra carrito = obtenerOCrearCarrito(usuarioId);
        carrito.getDetalles().clear();
        carrito.setTotalConDescuento(BigDecimal.ZERO);
        carrito.setTotalSinDescuento(BigDecimal.ZERO);
        compraRepository.save(carrito);
    }

    @Transactional(readOnly = true)
    public ValidarCarritoDTO validarCarrito(Integer usuarioId) {
        Compra carrito = obtenerOCrearCarrito(usuarioId);
        List<String> errores = new ArrayList<>();
        List<CarritoItemDTO> itemsConProblema = new ArrayList<>();

        for (DetalleDeCompra detalle : carrito.getDetalles()) {
            VarianteDeZapato variante = varianteRepository.findById(detalle.getVarianteDeZapato().getIdVarianteDeZapato())
                .orElse(null);
            
            if (variante == null || variante.getStock() < detalle.getCantidad()) {
                String msg = "Stock insuficiente para " + detalle.getNombreDelProducto() 
                    + " (disponible: " + (variante != null ? variante.getStock() : 0) 
                    + ", solicitado: " + detalle.getCantidad() + ")";
                errores.add(msg);
                itemsConProblema.add(mapToItemDTO(detalle, variante));
            }
        }

        return ValidarCarritoDTO.builder()
            .valido(errores.isEmpty())
            .errores(errores)
            .itemsConProblema(itemsConProblema)
            .build();
    }

    @Transactional
    public Compra prepararCheckout(Integer usuarioId) {
        // 1. Validar
        ValidarCarritoDTO validacion = validarCarrito(usuarioId);
        if (!validacion.isValido()) {
            throw new IllegalStateException("Carrito inválido: " + String.join("; ", validacion.getErrores()));
        }

        Usuario usuario = usuarioRepository.findById(usuarioId)
            .orElseThrow(() -> new EntityNotFoundException("Usuario no encontrado"));
        
        if (!usuario.getEstaVerificado() || !usuario.getEstaActivo()) {
            throw new IllegalStateException("Usuario no verificado o inactivo");
        }

        // 2. Obtener carrito con lock en variantes
        Compra carrito = compraRepository.findByIdWithCliente(carrito.getIdCompra())
            .orElseThrow(() -> new EntityNotFoundException("Carrito no encontrado"));

        // 3. Bloquear y descontar stock (SELECT FOR UPDATE)
        for (DetalleDeCompra detalle : carrito.getDetalles()) {
            VarianteDeZapato variante = varianteRepository.lockForUpdate(detalle.getVarianteDeZapato().getIdVarianteDeZapato());
            if (variante.getStock() < detalle.getCantidad()) {
                throw new IllegalStateException("Stock cambió durante checkout");
            }
            variante.setStock(variante.getStock() - detalle.getCantidad());
            varianteRepository.save(variante);
        }

        // 4. Cambiar estado
        carrito.setEstado("pendiente");
        carrito.setFechaDeCompra(LocalDateTime.now());
        
        return compraRepository.save(carrito);
    }

    private Compra obtenerOCrearCarrito(Integer usuarioId) {
        return compraRepository.findByClienteIdUsuarioAndEstado(usuarioId, "carrito")
            .orElseGet(() -> {
                Usuario usuario = usuarioRepository.getReferenceById(usuarioId);
                Compra nuevo = Compra.builder()
                    .cliente(usuario)
                    .estado("carrito")
                    .totalConDescuento(BigDecimal.ZERO)
                    .totalSinDescuento(BigDecimal.ZERO)
                    .build();
                return compraRepository.save(nuevo);
            });
    }

    private void recalcularDetalle(DetalleDeCompra detalle) {
        // Los @PrePersist/@PreUpdate de la entidad calculan precioConDescuento y precioSinDescuento
        // Solo necesitamos recalcular si cambiamos cantidad manualmente
    }

    private void recalcularCarrito(Compra carrito) {
        BigDecimal totalConDesc = carrito.getDetalles().stream()
            .map(DetalleDeCompra::getPrecioConDescuento)
            .reduce(BigDecimal.ZERO, BigDecimal::add);
        
        BigDecimal totalSinDesc = carrito.getDetalles().stream()
            .map(DetalleDeCompra::getPrecioSinDescuento)
            .reduce(BigDecimal.ZERO, BigDecimal::add);

        carrito.setTotalConDescuento(totalConDesc);
        carrito.setTotalSinDescuento(totalSinDesc);
    }

    private CarritoResponseDTO mapToDTO(Compra carrito) {
        List<CarritoItemDTO> items = carrito.getDetalles().stream()
            .map(this::mapToItemDTO)
            .collect(Collectors.toList());

        return CarritoResponseDTO.builder()
            .idCompra(carrito.getIdCompra())
            .items(items)
            .totalOriginal(carrito.getTotalSinDescuento())
            .totalDescuento(carrito.getTotalSinDescuento().subtract(carrito.getTotalConDescuento()))
            .totalConDescuento(carrito.getTotalConDescuento())
            .totalItems(items.stream().mapToInt(CarritoItemDTO::getCantidad).sum())
            .validoParaCheckout(items.stream().allMatch(CarritoItemDTO::getHayStockSuficiente))
            .build();
    }

    private CarritoItemDTO mapToItemDTO(DetalleDeCompra detalle) {
        return mapToItemDTO(detalle, detalle.getVarianteDeZapato());
    }

