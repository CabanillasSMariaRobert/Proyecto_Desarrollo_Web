    @Transactional
    public PedidoDetalleDTO procesarPago(Integer usuarioId, Integer idCompra, PagarPedidoRequestDTO request) {
        Compra compra = compraRepository.findByIdWithCliente(idCompra)
            .orElseThrow(() -> new EntityNotFoundException("Pedido no encontrado"));
        
        if (!compra.getCliente().getIdUsuario().equals(usuarioId)) {
            throw new AccessDeniedException("No autorizado");
        }
        if (!"pendiente".equals(compra.getEstado())) {
            throw new IllegalStateException("Pedido no está pendiente de pago");
        }

        // 1. Validar método de pago
        MetodoDePago metodo = metodoPagoRepository.findById(request.getIdMetodoPago())
            .orElseThrow(() -> new EntityNotFoundException("Método de pago no encontrado"));
        
        if (!metodo.getUsuario().getIdUsuario().equals(usuarioId)) {
            throw new AccessDeniedException("Método de pago no pertenece al usuario");
        }

        // 2. Procesar con pasarela (TODO: implementar integración real)
        // PagoResultado resultado = pasarelaService.cobrar(compra.getTotalConDescuento(), request);
        
        // Simulación exitosa:
        boolean pagoExitoso = true;
        String transaccionId = "txn_" + UUID.randomUUID().toString().substring(0, 12);
        
        if (!pagoExitoso) {
            throw new PaymentException("Pago rechazado");
        }

        // 3. Actualizar compra
        compra.setEstado("pagado");
        compra = compraRepository.save(compra);

        // 4. Crear Boleta
        Boleta boleta = Boleta.builder()
            .compra(compra)
            .metodoDePago(metodo)
            .cliente(compra.getCliente().getNombreCompleto())
            .rucDeLaTienda("20123456789") // Configurable
            .pasarelaDePago(request.getPasarela())
            .redDeTarjeta(metodo.getRedUsada())
            .ultimos4Digitos(metodo.getUltimos4Digitos())
            .total(compra.getTotalConDescuento())
            .build();
        boletaRepository.save(boleta);

        // 5. Crear Entrega (asignar punto más cercano al usuario)
        // TODO: Lógica geográfica para encontrar punto de entrega
        PuntoDeEntrega punto = puntoEntregaRepository.findAll().get(0); // Placeholder
        Entrega entrega = Entrega.builder()
            .compra(compra)
            .puntoDeEntrega(punto)
            .estado("pendiente")
            .build();
        entregaRepository.save(entrega);

        // 6. Notificar (async)
        // eventPublisher.publishEvent(new PedidoPagadoEvent(compra));

        return mapToDetalleDTO(compra);
    }

    @Transactional
    public void cancelarPedido(Integer usuarioId, Integer idCompra) {
        Compra compra = compraRepository.findByIdWithCliente(idCompra)
            .orElseThrow(() -> new EntityNotFoundException("Pedido no encontrado"));
        
        if (!compra.getCliente().getIdUsuario().equals(usuarioId)) {
            throw new AccessDeniedException("No autorizado");
        }
        
        if ("enviado".equals(compra.getEstado()) || "entregado".equals(compra.getEstado())) {
            throw new IllegalStateException("No se puede cancelar un pedido ya enviado");
        }

        // Devolver stock
        for (DetalleDeCompra detalle : compra.getDetalles()) {
            VarianteDeZapato variante = detalle.getVarianteDeZapato();
            variante.setStock(variante.getStock() + detalle.getCantidad());
            varianteRepository.save(variante);
        }

        // Si ya pagado, iniciar reembolso
        if ("pagado".equals(compra.getEstado())) {
            // TODO: Procesar reembolso en pasarela
            // reembolsoService.procesar(compra);
        }

        compra.setEstado("cancelado");
        compraRepository.save(compra);
    }

    @Transactional
    public PedidoDetalleDTO cambiarEstadoPedido(Integer idCompra, String nuevoEstado, String observacion) {
        Compra compra = compraRepository.findByIdWithCliente(idCompra)
            .orElseThrow(() -> new EntityNotFoundException("Pedido no encontrado"));

        // Validar transición
        validarTransicionEstado(compra.getEstado(), nuevoEstado);

        compra.setEstado(nuevoEstado);
        
        // Acciones según nuevo estado
        switch (nuevoEstado) {
            case "enviado" -> {
                Entrega entrega = entregaRepository.findByCompraIdCompra(idCompra)
                    .orElseThrow(() -> new EntityNotFoundException("Entrega no encontrada"));
                entrega.setEstado("asignado");
                entrega.setAsignadoEl(LocalDateTime.now());
                entregaRepository.save(entrega);
            }
            case "entregado" -> {
                Entrega entrega = entregaRepository.findByCompraIdCompra(idCompra)
                    .orElseThrow(() -> new EntityNotFoundException("Entrega no encontrada"));
                entrega.setEstado("entregado");
                entrega.setEntregadoEl(LocalDateTime.now());
                entregaRepository.save(entrega);
            }
        }

        compraRepository.save(compra);
        // Auditoría + notificación
        return mapToDetalleDTO(compra);
    }

    private void validarTransicionEstado(String actual, String nuevo) {
        Map<String, Set<String>> transiciones = Map.of(
            "pendiente", Set.of("pagado", "cancelado"),
            "pagado", Set.of("enviado", "cancelado"),
            "enviado", Set.of("entregado"),
            "entregado", Set.of(),
            "cancelado", Set.of()
        );
        
        if (!transiciones.getOrDefault(actual, Set.of()).contains(nuevo)) {
            throw new IllegalStateException("Transición inválida: " + actual + " -> " + nuevo);
        }
    }

    private PedidoResumenDTO mapToResumenDTO(Compra c) {
        Entrega entrega = entregaRepository.findByCompraIdCompra(c.getIdCompra()).orElse(null);
        return PedidoResumenDTO.builder()
            .idCompra(c.getIdCompra())
            .estado(c.getEstado())
            .fechaCompra(c.getFechaDeCompra())
            .total(c.getTotalConDescuento())
            .totalItems(c.getDetalles().size())
            .estadoEntrega(entrega != null ? entrega.getEstado() : "sin_entrega")
            .build();
    }

    private PedidoDetalleDTO mapToDetalleDTO(Compra c) {
        List<PedidoItemDTO> items = c.getDetalles().stream()
            .map(d -> PedidoItemDTO.builder()
                .idVariante(d.getVarianteDeZapato().getIdVarianteDeZapato())
                .nombreProducto(d.getNombreDelProducto())
                .urlImagen(d.getVarianteDeZapato().getZapato().getProducto().getUrlImagen())
                .talla(d.getVarianteDeZapato().getTalla())
                .color(d.getVarianteDeZapato().getColor())
                .precioOriginal(d.getPrecioOriginalXUnidad())
                .descuento(d.getDescuentoXUnidad())
                .precioConDescuento(d.getPrecioConDescuento().divide(BigDecimal.valueOf(d.getCantidad())))
                .cantidad(d.getCantidad())
                .subtotal(d.getPrecioConDescuento())
                .build())
            .collect(Collectors.toList());

        Boleta boleta = boletaRepository.findByCompraIdCompra(c.getIdCompra()).orElse(null);
        Entrega entrega = entregaRepository.findByCompraIdCompra(c.getIdCompra()).orElse(null);

        return PedidoDetalleDTO.builder()
            .idCompra(c.getIdCompra())
            .estado(c.getEstado())
            .fechaCompra(c.getFechaDeCompra())
            .totalOriginal(c.getTotalSinDescuento())
            .totalDescuento(c.getTotalSinDescuento().subtract(c.getTotalConDescuento()))
            .totalConDescuento(c.getTotalConDescuento())
            .items(items)
            .pago(boleta != null ? mapToPagoDTO(boleta) : null)
            .entrega(entrega != null ? mapToEntregaDTO(entrega) : null)
            .boleta(boleta != null ? mapToBoletaDTO(boleta) : null)
            .build();
    }

    private PagoInfoDTO mapToPagoDTO(Boleta b) {
        return PagoInfoDTO.builder()
            .metodoPago(b.getMetodoDePago().getPasarela())
            .ultimos4Digitos(b.getUltimos4Digitos())
            .pasarela(b.getPasarelaDePago())
            .monto(b.getTotal())
            .fechaPago(b.getCreadoEl())
            .estado("aprobado")
            .build();
    }

    private EntregaInfoDTO mapToEntregaDTO(Entrega e) {
        return EntregaInfoDTO.builder()
