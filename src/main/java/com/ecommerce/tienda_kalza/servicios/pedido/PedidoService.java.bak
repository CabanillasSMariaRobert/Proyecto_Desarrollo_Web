/**
 * SERVICIO PEDIDOS - Gestión completa de órdenes
 * 
 * REPOSITORIOS NECESARIOS:
 * - CompraRepository
 * - DetalleDeCompraRepository
 * - BoletaRepository
 * - EntregaRepository
 * - MetodoDePagoRepository
 * - PuntoDeEntregaRepository
 * - UsuarioRepository
 * - VarianteDeZapatoRepository (para re-stock si cancelación)
 * 
 * MÉTODOS A IMPLEMENTAR:
 * 
 * 1. listarMisPedidos(Integer usuarioId, FiltroPedidosDTO filtro) -> Page<PedidoResumenDTO>
 *    - Solo pedidos del usuario (estado != carrito)
 *    - Filtros: estado, fechaDesde/hasta
 *    - Incluir info de entrega para tracking
 * 
 * 2. obtenerDetallePedido(Integer usuarioId, Integer idCompra) -> PedidoDetalleDTO
 *    - Validar que pedido pertenece al usuario (o es admin)
 *    - Cargar: items, pago, entrega, boleta
 * 
 * 3. procesarPago(Integer usuarioId, Integer idCompra, PagarPedidoRequestDTO request) -> PedidoDetalleDTO
 *    - Validar compra: estado="pendiente", pertenece a usuario
 *    - Validar método de pago pertenece al usuario
 *    - Llamar pasarela de pago (MercadoPago, Culqi, PayPal, etc.)
 *    - Si éxito:
 *      - Cambiar estado compra -> "pagado"
 *      - Crear Boleta
 *      - Crear Entrega (estado="pendiente", asignar punto de entrega)
 *      - Notificar usuario (email/push)
 *    - Si fallo: mantener estado="pendiente", registrar intento
 * 
 * 4. cancelarPedido(Integer usuarioId, Integer idCompra) -> void
 *    - Solo si estado="pendiente" o "pagado" (no enviado)
 *    - Si pagado: iniciar reembolso
 *    - Devolver stock a variantes
 *    - Cambiar estado -> "cancelado"
 * 
 * 5. (ADMIN) cambiarEstadoPedido(Integer idCompra, String nuevoEstado, String observacion) -> PedidoDetalleDTO
 *    - Validar transición de estado permitida
 *    - Estados: pendiente -> pagado -> enviado -> entregado
 *    -                 \-> cancelado (desde pendiente/pagado)
 *    - Si enviado: crear/actualizar Entrega, asignar transportista
 *    - Si entregado: marcar Entrega.fechaEntregado = now
 *    - Notificar usuario
 * 
 * 6. (ADMIN) listarTodosPedidos(FiltroPedidosDTO filtro) -> Page<PedidoResumenDTO>
 *    - Ver todos, con info de cliente
 * 
 * 7. obtenerReporteVentas(LocalDateTime desde, LocalDateTime hasta) -> ReporteVentasDTO
 *    - Total ventas, pedidos, ticket promedio
 *    - Por categoría, marca, método pago
 *    - Top productos
 * 
 * CONSIDERACIONES:
 * - @Transactional en métodos que modifican
 * - Idempotencia en pago (evitar doble cargo)
 * - Manejo de reembolsos (parcial/total)
 * - Notificaciones async (eventos + message queue)
 * - Auditoría de cambios de estado
 */

@Service
@RequiredArgsConstructor
public class PedidoService {

