package com.ecommerce.tienda_kalza.controladores.pedido;

import com.ecommerce.tienda_kalza.dtos.pedido.*;
import com.ecommerce.tienda_kalza.servicios.pedido.PedidoService;
import jakarta.validation.Valid;
import org.springframework.data.domain.Page;
import org.springframework.http.ResponseEntity;
import org.springframework.security.access.prepost.PreAuthorize;
import org.springframework.security.core.annotation.AuthenticationPrincipal;
import org.springframework.security.core.userdetails.UserDetails;
import org.springframework.web.bind.annotation.*;

/**
 * CONTROLADOR PEDIDOS - Endpoints para gestión de órdenes
 * 
 * BASE PATH: /api/pedidos (usuario) /api/admin/pedidos (admin)
 * AUTENTICACIÓN: Requiere JWT
 * 
 * ENDPOINTS USUARIO:
 * 
 * GET    /api/pedidos                    -> Listar mis pedidos (con filtros)
 * GET    /api/pedidos/{id}               -> Detalle de mi pedido
 * POST   /api/pedidos/{id}/pagar         -> Procesar pago
 * POST   /api/pedidos/{id}/cancelar      -> Cancelar pedido
 * GET    /api/pedidos/{id}/boleta        -> Descargar boleta PDF
 * GET    /api/pedidos/{id}/tracking      -> Tracking de entrega
 * 
 * ENDPOINTS ADMIN:
 * 
 * GET    /api/admin/pedidos              -> Listar todos (con filtros)
 * GET    /api/admin/pedidos/{id}         -> Detalle cualquier pedido
 * PUT    /api/admin/pedidos/{id}/estado  -> Cambiar estado (pagado, enviado, entregado, cancelado)
 * GET    /api/admin/pedidos/reporte      -> Reporte de ventas
 * 
 * EJEMPLOS:
 * 
 * Mis pedidos:
 * GET /api/pedidos?estado=pagado&page=0&size=10
 * Header: Authorization: Bearer <token>
 * 
 * Pagar:
 * POST /api/pedidos/42/pagar
 * Body: { "idMetodoPago": 3, "pasarela": "mercadopago", "tokenPago": "card_token_xyz" }
 * 
 * Admin - cambiar estado:
 * PUT /api/admin/pedidos/42/estado
 * Body: { "nuevoEstado": "enviado", "observacion": "Enviado por Olva Courier" }
 */

@RestController
@RequestMapping("/api/pedidos")
public class PedidoController {

    //private final PedidoService pedidoService;

