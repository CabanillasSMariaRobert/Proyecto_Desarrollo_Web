    public ResponseEntity<ValidarCarritoDTO> validarCarrito(@AuthenticationPrincipal UserDetails userDetails) {
        Integer usuarioId = obtenerUsuarioId(userDetails);
        return ResponseEntity.ok(carritoService.validarCarrito(usuarioId));
    }

