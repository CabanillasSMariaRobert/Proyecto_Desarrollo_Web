        Integer usuarioId = obtenerUsuarioId(userDetails);
        return ResponseEntity.ok(carritoService.actualizarCantidad(usuarioId, idVariante, request.getCantidad()));
    }

    @DeleteMapping("/items/{idVariante}")
    public ResponseEntity<CarritoResponseDTO> eliminarItem(
            @AuthenticationPrincipal UserDetails userDetails,
            @PathVariable Integer idVariante) {
        Integer usuarioId = obtenerUsuarioId(userDetails);
        return ResponseEntity.ok(carritoService.eliminarItem(usuarioId, idVariante));
    }

    @DeleteMapping
