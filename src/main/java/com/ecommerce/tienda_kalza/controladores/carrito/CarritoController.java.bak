package com.ecommerce.tienda_kalza.controladores.carrito;

import com.ecommerce.tienda_kalza.dtos.carrito.*;
import com.ecommerce.tienda_kalza.servicios.carrito.CarritoService;
import jakarta.validation.Valid;
import org.springframework.http.ResponseEntity;
import org.springframework.security.core.annotation.AuthenticationPrincipal;
import org.springframework.security.core.userdetails.UserDetails;
import org.springframework.web.bind.annotation.*;

/**
 * CONTROLADOR CARRITO - Endpoints para gestión del carrito
 * 
 * BASE PATH: /api/carrito
 * AUTENTICACIÓN: Requiere JWT (ROLE_USER o ROLE_ADMIN)
 * Usuario se obtiene de SecurityContext via @AuthenticationPrincipal
 * 
 * ENDPOINTS:
 * 
 * GET    /api/carrito                    -> Ver carrito actual
 * POST   /api/carrito/items              -> Agregar item
 * PUT    /api/carrito/items/{idVariante} -> Actualizar cantidad
 * DELETE /api/carrito/items/{idVariante} -> Eliminar item
 * DELETE /api/carrito                    -> Vaciar carrito
 * POST   /api/carrito/validar            -> Validar stock antes de checkout
 * POST   /api/carrito/checkout           -> Preparar checkout (bloquea stock)
 * 
 * EJEMPLOS:
 * 
 * Ver carrito:
 * GET /api/carrito
 * Header: Authorization: Bearer <token>
 * 
 * Agregar item:
 * POST /api/carrito/items
 * Header: Authorization: Bearer <token>
 * Body: { "idVariante": 15, "cantidad": 2 }
 * 
 * Actualizar cantidad:
 * PUT /api/carrito/items/15
 * Body: { "cantidad": 3 }
 * 
 * Validar:
 * POST /api/carrito/validar
 * 
 * Checkout:
 * POST /api/carrito/checkout
 * Response: Compra con estado="pendiente" lista para pago
 */

@RestController
@RequestMapping("/api/carrito")
public class CarritoController {

    //private final CarritoService carritoService;

    /*
