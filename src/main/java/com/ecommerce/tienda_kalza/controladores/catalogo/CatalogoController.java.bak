package com.ecommerce.tienda_kalza.controladores.catalogo;

import com.ecommerce.tienda_kalza.dtos.catalogo.*;
import com.ecommerce.tienda_kalza.servicios.catalogo.CatalogoService;
import jakarta.validation.Valid;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

/**
 * CONTROLADOR CATÁLOGO - Endpoints públicos para catálogo
 * 
 * BASE PATH: /api/catalogo
 * 
 * ENDPOINTS A IMPLEMENTAR:
 * 
 * GET    /api/catalogo/productos              -> Listar con filtros/paginación
 * GET    /api/catalogo/productos/{id}         -> Detalle producto
 * GET    /api/catalogo/productos/buscar       -> Búsqueda textual
 * GET    /api/catalogo/categorias             -> Lista categorías (para filtros)
 * GET    /api/catalogo/marcas                 -> Lista marcas (para filtros)
 * GET    /api/catalogo/filtros                -> Filtros disponibles con counts
 * GET    /api/catalogo/productos/{id}/relacionados -> Productos relacionados
 * 
 * TODOS PÚBLICOS (sin autenticación)
 * 
 * EJEMPLOS DE USO:
 * 
 * Listar productos:
 * GET /api/catalogo/productos?page=0&size=12&categoria=1&marca=2&precioMin=50&precioMax=200&orden=precio_asc
 * 
 * Detalle:
 * GET /api/catalogo/productos/15
 * 
 * Buscar:
 * GET /api/catalogo/productos/buscar?q=nike&page=0&size=10
 * 
 * Filtros:
 * GET /api/catalogo/filtros
 */

@RestController
@RequestMapping("/api/catalogo")
public class CatalogoController {

    //private final CatalogoService catalogoService;

