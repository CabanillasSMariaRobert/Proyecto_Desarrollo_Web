package com.ecommerce.tienda_kalza.controladores.admin;

import com.ecommerce.tienda_kalza.dtos.admin.*;
import com.ecommerce.tienda_kalza.servicios.admin.AdminService;
import jakarta.validation.Valid;
import org.springframework.data.domain.Page;
import org.springframework.http.ResponseEntity;
import org.springframework.security.access.prepost.PreAuthorize;
import org.springframework.web.bind.annotation.*;

import java.time.LocalDateTime;
import java.util.List;

/**
 * CONTROLADOR ADMIN - Panel de administración
 * 
 * BASE PATH: /api/admin
 * AUTENTICACIÓN: Requiere JWT + ROLE_ADMIN
 * TODOS LOS ENDPOINTS TIENEN @PreAuthorize("hasRole('ADMIN')")
 * 
 * MÓDULOS:
 * 
 * ===== USUARIOS =====
 * GET    /api/admin/usuarios              -> Listar (paginado, filtros)
 * GET    /api/admin/usuarios/{id}         -> Detalle
 * PUT    /api/admin/usuarios/{id}         -> Actualizar
 * POST   /api/admin/usuarios/{id}/banear  -> Banear
 * POST   /api/admin/usuarios/{id}/desbanear -> Desbanear
 * 
 * ===== PRODUCTOS =====
 * GET    /api/admin/productos             -> Listar admin
 * GET    /api/admin/productos/{id}        -> Detalle completo
 * POST   /api/admin/productos             -> Crear
 * PUT    /api/admin/productos/{id}        -> Actualizar
 * DELETE /api/admin/productos/{id}        -> Eliminar
 * POST   /api/admin/productos/{id}/variantes -> Agregar variante
 * PUT    /api/admin/productos/variantes/{idVariante} -> Actualizar variante
 * DELETE /api/admin/productos/variantes/{idVariante} -> Eliminar variante
 * 
 * ===== CATEGORÍAS =====
 * GET    /api/admin/categorias            -> Listar
 * POST   /api/admin/categorias            -> Crear
 * PUT    /api/admin/categorias/{id}       -> Actualizar
 * DELETE /api/admin/categorias/{id}       -> Eliminar
 * 
 * ===== MARCAS =====
 * GET    /api/admin/marcas                -> Listar
 * POST   /api/admin/marcas                -> Crear
 * PUT    /api/admin/marcas/{id}           -> Actualizar
 * DELETE /api/admin/marcas/{id}           -> Eliminar
 * 
 * ===== PUBLICIDAD =====
 * GET    /api/admin/publicidad            -> Listar banners
 * POST   /api/admin/publicidad            -> Crear banner
 * PUT    /api/admin/publicidad/{id}       -> Actualizar
 * DELETE /api/admin/publicidad/{id}       -> Eliminar
 * PUT    /api/admin/publicidad/{id}/toggle -> Activar/Desactivar
 * 
 * ===== MÉTRICAS =====
 * GET    /api/admin/metricas/dashboard    -> KPIs principales
 * GET    /api/admin/metricas/ventas       -> Ventas por período
 * GET    /api/admin/metricas/productos    -> Top productos
 * 
 * EJEMPLOS:
 * 
 * Listar usuarios:
 * GET /api/admin/usuarios?page=0&size=20&filtro=juan&orden=nombre_asc
 * 
 * Crear producto:
 * POST /api/admin/productos
 * Body: { "nombre": "Nike Air Max", "precioOriginal": 399.90, "marcaId": 1, "categoriasIds": [2,3], "variantes": [{ "talla": 42, "color": "negro", "stock": 10 }] }
 * 
 * Dashboard:
 * GET /api/admin/metricas/dashboard
 */

@RestController
@RequestMapping("/api/admin")
@PreAuthorize("hasRole('ADMIN')")
public class AdminController {

